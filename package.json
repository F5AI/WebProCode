{
  "name": "f5-ai-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node --env-file-if-exists=.env server/index.mjs",
    "build": "tsc -b && vite build",
    "preview:export": "npm run build && node scripts/export-preview.mjs",
    "start": "node --env-file-if-exists=.env --import ./scripts/production-env.mjs server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "admin": "node --env-file-if-exists=.env server/index.mjs --create-admin",
    "test:browser": "node tests/browser-smoke.cjs",
    "test:preview": "node tests/offline-preview.cjs",
    "test:admin": "node tests/admin-browser.cjs"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.64.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
