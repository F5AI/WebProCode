# Copy to .env locally. Never commit .env or enter passwords in chat.
PORT=3001
# For a public deployment, set APP_ORIGIN to the exact HTTPS website origin.
APP_ORIGIN=http://localhost:5173
TRUST_PROXY=0

# Optional: receiving bank information. When all three are set, membership
# checkout becomes available. These fields are public payment instructions.
BANK_NAME=
BANK_ACCOUNT=
BANK_ACCOUNT_NAME=

# Optional: creator/admin account. Supply your own email and strong password
# (at least 12 characters), run npm run admin once, then remove the password.
# No administrator is created automatically and there is no default password.
F5AI_ADMIN_EMAIL=
F5AI_ADMIN_PASSWORD=
