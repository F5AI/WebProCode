# Copy to .env locally. Never commit .env or enter passwords in chat.
PORT=3001
# Interface to bind. Keep 0.0.0.0 behind a reverse proxy/container; use 127.0.0.1 when a local proxy is the only client.
HOST=0.0.0.0
# For a public deployment, set APP_ORIGIN to the exact HTTPS website origin (no path).
APP_ORIGIN=http://localhost:5173
# Public domain for deploy/docker-compose.yml (Caddy certificate + APP_ORIGIN). Read via `docker compose --env-file .env`.
DOMAIN=
# Set to 1 only when exactly one trusted reverse proxy sits in front of Node (affects req.ip and HTTPS detection).
TRUST_PROXY=0
# Session cookies are Secure whenever NODE_ENV=production. Set COOKIE_SECURE=0 only for a plain-HTTP demo
# on a private network; never on a public website.
COOKIE_SECURE=

# Membership plan. Change here, not in code; the UI reads these values from /api/membership/config.
PLAN_PRICE=199000
PLAN_DAYS=30

# Optional: receiving bank information. When all three are set, membership
# checkout becomes available. These fields are public payment instructions.
BANK_NAME=
BANK_ACCOUNT=
BANK_ACCOUNT_NAME=

# Optional: creator/admin account. Supply your own email and strong password
# (at least 12 characters), run npm run admin once, then remove the password.
# No administrator is created automatically and there is no default password.
F5AI_ADMIN_EMAIL=
F5AI_ADMIN_PASSWORD=
